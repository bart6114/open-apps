---
interface Props {
  /** App slug to toggle. */
  slug: string;
  /** Visual variant: "card" (corner, semi-transparent) or "detail" (inline button). */
  variant?: "card" | "detail";
  class?: string;
}

const { slug, variant = "card", class: className = "" } = Astro.props;
const variantClass =
  variant === "card"
    ? "watch-btn watch-btn-card absolute right-3 top-3 z-20 flex h-8 w-8 items-center justify-center rounded-full border border-ink-200 bg-white/85 backdrop-blur transition-all hover:scale-110 dark:border-ink-800 dark:bg-ink-950/85"
    : "watch-btn watch-btn-detail btn-outline";
---

<button
  type="button"
  data-watch-toggle={slug}
  data-watch-variant={variant}
  aria-label={`Watch ${slug}`}
  aria-pressed="false"
  title="Watch this app — adds it to your local watchlist"
  class={`${variantClass} ${className}`.trim()}
>
  {variant === "card" ? (
    <svg
      viewBox="0 0 16 16"
      width="14"
      height="14"
      aria-hidden="true"
      fill="currentColor"
      class="watch-icon-outline transition-colors"
    >
      <path d="M8 14.25l-1.45-1.32C2.4 9.36 0 7.18 0 4.5 0 2.42 1.42 1 3.5 1c1.74 0 3.41 1.01 4.5 2.61C9.09 2.01 10.76 1 12.5 1 14.58 1 16 2.42 16 4.5c0 2.68-2.4 4.86-6.55 8.43L8 14.25z"/>
    </svg>
  ) : (
    <span class="inline-flex items-center gap-1.5">
      <svg
        viewBox="0 0 16 16"
        width="14"
        height="14"
        aria-hidden="true"
        fill="currentColor"
        class="watch-icon-outline"
      >
        <path d="M8 14.25l-1.45-1.32C2.4 9.36 0 7.18 0 4.5 0 2.42 1.42 1 3.5 1c1.74 0 3.41 1.01 4.5 2.61C9.09 2.01 10.76 1 12.5 1 14.58 1 16 2.42 16 4.5c0 2.68-2.4 4.86-6.55 8.43L8 14.25z"/>
      </svg>
      <span class="watch-text">Watch</span>
    </span>
  )}
</button>

<script>
  import {
    readWatchlist,
    toggleWatched,
    WATCHLIST_EVENT,
  } from "../../lib/watchlist";

  /**
   * Re-render every watch button in the document to match the
   * current watchlist. Idempotent — call any time the list changes.
   */
  function syncButtons() {
    const list = readWatchlist();
    document
      .querySelectorAll<HTMLButtonElement>("[data-watch-toggle]")
      .forEach((btn) => {
        const slug = btn.dataset.watchToggle!;
        const watched = list.includes(slug);
        btn.setAttribute("aria-pressed", watched ? "true" : "false");
        btn.classList.toggle("is-watched", watched);
        const text = btn.querySelector(".watch-text");
        if (text) text.textContent = watched ? "Watching" : "Watch";
        const label = watched ? `Unwatch ${slug}` : `Watch ${slug}`;
        btn.setAttribute("aria-label", label);
        btn.setAttribute(
          "title",
          watched
            ? "Remove from your local watchlist"
            : "Add to your local watchlist",
        );
      });
  }

  // Initial paint after DOM is ready.
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", syncButtons);
  } else {
    syncButtons();
  }

  // Click handler — event delegation. Stops propagation so the
  // surrounding card link (AppCard's stretched link) doesn't
  // navigate when the user just wants to toggle the watch.
  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
      "[data-watch-toggle]",
    );
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();
    const slug = btn.dataset.watchToggle!;
    toggleWatched(slug);
    syncButtons();
  });

  // Cross-component / cross-tab sync.
  window.addEventListener(WATCHLIST_EVENT, syncButtons);
  window.addEventListener("storage", (e) => {
    if (e.key === "open-apps:watchlist") syncButtons();
  });
</script>

<style>
  .watch-icon-outline {
    color: theme("colors.ink.500");
    transition: color 150ms ease, transform 150ms ease;
  }
  :global(.dark) .watch-icon-outline {
    color: theme("colors.ink.400");
  }
  .watch-btn.is-watched .watch-icon-outline {
    color: theme("colors.emerald.700");
  }
  .watch-btn.is-watched:hover .watch-icon-outline {
    color: theme("colors.emerald.400");
  }
  .watch-btn-card.is-watched {
    border-color: theme("colors.emerald.300");
    background-color: theme("colors.emerald.50");
  }
  :global(.dark) .watch-btn-card.is-watched {
    border-color: theme("colors.emerald.800");
    background-color: theme("colors.emerald.950");
  }
</style>
