---
import type { OpenSourceApp } from "../../data/types";
import Icon from "../icons/Icon.astro";

interface Props {
  app: OpenSourceApp;
}

const { app } = Astro.props;

// Pick the most prominent label for the badge.
const label =
  app.labels?.find((l) => l === "new" || l === "hot" || l === "mature") ??
  app.labels?.[0];

const labelClass = label === "new"
  ? "badge-new"
  : label === "hot"
    ? "badge-hot"
    : label === "mature"
      ? "badge-mature"
      : "";

// Initials for placeholder logo (first 2 letters of any word in name).
const initials = app.name
  .split(/\s+/)
  .map((w) => w[0])
  .filter(Boolean)
  .slice(0, 2)
  .join("")
  .toUpperCase();

// Resolve a logo URL for this app, in order of preference:
//   1. Explicit `logoUrl` on the app
//   2. Derived from `repoUrl` if it's a github.com URL
//      (uses GitHub's opengraph endpoint which returns the repo's
//      social preview image, or auto-generates one with the repo name)
//   3. None — falls back to the initials placeholder
let logoUrl: string | null = app.logoUrl ?? null;
if (!logoUrl && app.repoUrl.includes("github.com/")) {
  // Strip "https://github.com/" prefix and any trailing path.
  const m = app.repoUrl.match(/github\.com\/([^/]+)\/([^/?#]+)/);
  if (m) {
    const owner = m[1];
    const repo = m[2].replace(/\.git$/, "");
    logoUrl = `https://opengraph.githubassets.com/preview/${owner}/${repo}`;
  }
}

// Show up to 3 platforms; overflow as +N.
const visiblePlatforms = app.platforms.slice(0, 3);
const platformOverflow = app.platforms.length - visiblePlatforms.length;

// Show up to 3 stack chips (primary + first 2 secondary).
const allStacks = [app.stack, ...(app.stacks ?? [])].filter(Boolean);
const visibleStacks = allStacks.slice(0, 3);
const stackOverflow = allStacks.length - visibleStacks.length;
---

<article
  class="card card-hover group relative flex h-full flex-col gap-3 p-4"
>
  {/* Top row: logo + name + label badge. Logo is optional —
      falls back to a clean initials placeholder. */}
  <header class="flex items-start gap-3">
    {logoUrl ? (
      <img
        src={logoUrl}
        alt={`${app.name} logo`}
        width="40"
        height="40"
        loading="lazy"
        decoding="async"
        class="h-10 w-10 shrink-0 rounded-md border border-ink-200 object-cover dark:border-ink-800"
      />
    ) : (
      <span
        aria-hidden="true"
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md border border-ink-200 bg-ink-50 text-2xs font-semibold text-ink-700 dark:border-ink-800 dark:bg-ink-900/60 dark:text-ink-300"
      >
        {initials}
      </span>
    )}

    <div class="flex min-w-0 flex-1 flex-col gap-0.5">
      <h3
        class="m-0 truncate text-[0.9375rem] font-semibold tracking-tight text-ink-900 group-hover:underline dark:text-ink-100"
      >
        <a
          href={app.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-inherit no-underline"
        >
          {app.name}
        </a>
      </h3>
      <span class="truncate text-2xs text-ink-500 dark:text-ink-400">
        {app.category}
      </span>
    </div>

    {label && (
      <span class={`badge ${labelClass} shrink-0`}>
        {label.toUpperCase()}
      </span>
    )}
  </header>

  {/* Description */}
  <p
    class="m-0 line-clamp-2 text-[0.8125rem] leading-relaxed text-ink-500 dark:text-ink-400"
  >
    {app.description}
  </p>

  {/* Platform chips */}
  <div class="flex flex-wrap items-center gap-1.5">
    {visiblePlatforms.map((p) => (
      <span class="chip">
        <Icon name={p} category="platform" size={12} />
        <span>{p}</span>
      </span>
    ))}
    {platformOverflow > 0 && (
      <span class="chip text-ink-400 dark:text-ink-500">+{platformOverflow}</span>
    )}
  </div>

  {/* Stack chips */}
  <div class="mt-auto flex flex-wrap items-center gap-1.5">
    {visibleStacks.map((s) => (
      <span class="chip chip-stack">
        <Icon name={s} category="stack" size={12} />
        <span>{s}</span>
      </span>
    ))}
    {stackOverflow > 0 && (
      <span class="chip chip-stack text-ink-400 dark:text-ink-500">+{stackOverflow}</span>
    )}
  </div>
</article>

<style>
  .chip {
    @apply inline-flex items-center gap-1 rounded-md border border-ink-200 bg-white px-1.5 py-0.5 text-2xs font-medium text-ink-700 transition-colors dark:border-ink-800 dark:bg-ink-950 dark:text-ink-300;
  }
  .chip-stack {
    @apply bg-ink-50 dark:bg-ink-900/60;
  }
</style>
