---
import type { Contributor } from "../../data/contributors";
import SectionHeader from "../layout/SectionHeader.astro";
import Container from "../layout/Container.astro";

interface Props {
  contributors: Contributor[];
  /**
   * Total count of contributors in the directory, used to render
   * "Showing 24 of 47" when the homepage is capped for layout reasons.
   * Falls back to `contributors.length` when not provided.
   */
  totalCount?: number;
}

const { contributors, totalCount } = Astro.props;
const total = typeof totalCount === "number" ? totalCount : contributors.length;
const isCapped = total > contributors.length;
const topContributors = contributors.slice(0, 10);
const otherContributors = contributors.slice(10);
---

<section
  id="contributors"
  class="section scroll-mt-20 border-b border-ink-200 dark:border-ink-800"
>
  <Container>
    <SectionHeader
      eyebrow="Community"
      title="Thanks to every contributor."
      description="This directory exists because people keep discovering, submitting, reviewing, and maintaining open-source app references."
    />

    <ul class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(88px,1fr))] gap-x-2 gap-y-4 p-0">
      {
        topContributors.map((c) => (
          <li class="flex flex-col items-center gap-1.5 text-center">
            <a
              href={c.profileUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${c.name ?? c.username} on GitHub`}
              title={c.name ?? c.username}
              class="block transition-opacity hover:opacity-80"
            >
              <img
                src={c.avatarUrl}
                alt={`${c.name ?? c.username} avatar`}
                loading="lazy"
                width="48"
                height="48"
                class="h-12 w-12 rounded-full border border-ink-200 bg-white object-cover dark:border-ink-800 dark:bg-ink-900"
              />
            </a>
            <a
              href={c.profileUrl}
              target="_blank"
              rel="noopener noreferrer"
              title={c.name ?? c.username}
              class="block max-w-full truncate text-2xs text-ink-500 transition-colors hover:text-ink-900 dark:text-ink-400 dark:hover:text-ink-100"
            >
              {c.username}
            </a>
          </li>
        ))
      }
    </ul>

    {otherContributors.length > 0 && (
      <ul class="mt-6 m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(48px,1fr))] gap-2 p-0 sm:grid-cols-[repeat(auto-fill,minmax(56px,1fr))]">
        {otherContributors.map((c) => (
          <li class="flex justify-center">
            <a
              href={c.profileUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${c.name ?? c.username} on GitHub`}
              title={`${c.name ?? c.username}${typeof c.contributions === "number" ? ` · ${c.contributions} contributions` : ""}`}
              class="group block rounded-full transition-opacity hover:opacity-80"
            >
              <img
                src={c.avatarUrl}
                alt={`${c.name ?? c.username} avatar`}
                loading="lazy"
                width="32"
                height="32"
                class="h-8 w-8 rounded-full border border-ink-200 bg-white object-cover dark:border-ink-800 dark:bg-ink-900"
              />
            </a>
          </li>
        ))}
      </ul>
    )}

    <p
      class="mt-6 text-2xs text-ink-500 dark:text-ink-400 m-0"
    >
      {isCapped ? (
        <>Showing {contributors.length} of {total} contributors.</>
      ) : contributors.length > 10 ? (
        <>Showing top 10 plus {contributors.length - 10} more contributors.</>
      ) : (
        <>Showing all {total} contributors.</>
      )}
      <a
        href="https://github.com/tortuvshin/open-apps/graphs/contributors"
        target="_blank"
        rel="noopener noreferrer"
        class="ml-2 text-ink-700 hover:text-ink-900 dark:text-ink-300 dark:hover:text-ink-100"
      >
        View on GitHub →
      </a>
    </p>
  </Container>
</section>
