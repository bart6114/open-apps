---
import type { Contributor } from "../../data/contributors";
import SectionHeader from "../layout/SectionHeader.astro";
import Container from "../layout/Container.astro";

interface Props {
  contributors: Contributor[];
}

const { contributors } = Astro.props;
---

<section
  id="contributors"
  class="section scroll-mt-20 border-b border-ink-200 dark:border-ink-800"
>
  <Container>
    <SectionHeader
      eyebrow="Community"
      title="Thanks to every contributor."
      description="This directory exists because people keep discovering, submitting, reviewing, and maintaining open-source app references."
    />

    <ul
      class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(96px,1fr))] gap-x-2 gap-y-4 p-0"
    >
      {
        contributors.map((c) => (
          <li class="flex flex-col items-center gap-1.5 text-center">
            <a
              href={c.profileUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${c.name ?? c.username} on GitHub`}
              title={c.name ?? c.username}
              class="block transition-opacity hover:opacity-80"
            >
              <img
                src={c.avatarUrl}
                alt={`${c.name ?? c.username} avatar`}
                loading="lazy"
                width="48"
                height="48"
                class="h-12 w-12 rounded-full border border-ink-200 bg-white object-cover dark:border-ink-800 dark:bg-ink-900"
              />
            </a>
            <a
              href={c.profileUrl}
              target="_blank"
              rel="noopener noreferrer"
              title={c.name ?? c.username}
              class="block max-w-full truncate text-2xs text-ink-500 transition-colors hover:text-ink-900 dark:text-ink-400 dark:hover:text-ink-100"
            >
              {c.username}
            </a>
          </li>
        ))
      }
    </ul>

    <p
      class="mt-6 text-2xs text-ink-500 dark:text-ink-400 m-0"
    >
      Showing all {contributors.length} contributors.
      <a
        href="https://github.com/tortuvshin/open-source-flutter-apps/graphs/contributors"
        target="_blank"
        rel="noopener noreferrer"
        class="ml-2 text-ink-700 hover:text-ink-900 dark:text-ink-300 dark:hover:text-ink-100"
      >
        View on GitHub →
      </a>
    </p>
  </Container>
</section>
