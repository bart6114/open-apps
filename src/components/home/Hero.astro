---
import Container from "../layout/Container.astro";

const githubUrl = "https://github.com/tortuvshin/open-source-flutter-apps";
---

<section class="border-b border-ink-200 dark:border-ink-800">
  <Container>
    <div class="py-14 sm:py-20">
      <div class="max-w-3xl">
        <span
          class="inline-flex items-center gap-1.5 text-2xs font-medium text-ink-500 dark:text-ink-400"
        >
          <span
            aria-hidden="true"
            class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500"
          ></span>
          Open Source Apps · v0.1
        </span>
        <h1
          class="mt-3 text-[2.25rem] sm:text-[2.75rem] md:text-[3rem] font-semibold tracking-[-0.02em] leading-[1.05] text-ink-900 dark:text-ink-100 m-0"
        >
          Discover real<br class="hidden sm:block" />
          open-source apps.
        </h1>
        <p
          class="mt-4 text-[0.9375rem] sm:text-[1rem] leading-relaxed text-ink-500 dark:text-ink-400 m-0 max-w-[58ch]"
        >
          A static, community-curated directory of real app codebases —
          starting with mobile.
        </p>
      </div>

      <form
        class="mt-7 flex flex-col gap-2 sm:flex-row sm:items-center"
        role="search"
        action="/search"
        method="get"
      >
        <label class="relative flex-1">
          <span class="sr-only">Search apps, stacks, categories, licenses</span>
          <svg
            viewBox="0 0 16 16"
            width="16"
            height="16"
            aria-hidden="true"
            class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-ink-400"
            fill="currentColor"
          >
            <path
              d="M10.68 11.74a6 6 0 0 1-7.922-8.982 6 6 0 0 1 8.982 7.922l3.04 3.04a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215ZM11.5 7a4.499 4.499 0 1 0-8.997 0A4.499 4.499 0 0 0 11.5 7Z"
            ></path>
          </svg>
          <input
            type="search"
            name="q"
            placeholder="Search apps, stacks, categories, licenses..."
            class="w-full rounded-md border border-ink-200 bg-white py-2.5 pl-10 pr-3 text-[0.9375rem] text-ink-900 placeholder:text-ink-400 focus:border-ink-900 focus:outline-none focus:ring-2 focus:ring-ink-900/10 dark:border-ink-800 dark:bg-ink-950 dark:text-ink-100 dark:placeholder:text-ink-500 dark:focus:border-ink-100 dark:focus:ring-ink-100/15"
          />
        </label>
        <button type="submit" class="btn-primary">
          Search
        </button>
      </form>

      <p
        class="mt-2 text-2xs text-ink-500 dark:text-ink-400 m-0"
        aria-hidden="true"
      >
        Try{" "}
        <span class="font-mono text-ink-700 dark:text-ink-300">Flutter finance</span>,{" "}
        <span class="font-mono text-ink-700 dark:text-ink-300">React Native chat</span>,{" "}
        <span class="font-mono text-ink-700 dark:text-ink-300">Android productivity</span>
      </p>

      <div class="mt-5 flex flex-wrap items-center gap-2">
        <a href="#new" class="btn-primary">Browse apps</a>
        <a
          href={`${githubUrl}/blob/main/CONTRIBUTING.md`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline">Submit app</a
        >
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
          >View GitHub →</a
        >
      </div>

      <p
        class="mt-7 text-2xs text-ink-500 dark:text-ink-400 m-0"
      >
        Built from a 4k+ starred Flutter collection
        <span class="mx-2 text-ink-300 dark:text-ink-700">·</span>
        Community-curated
        <span class="mx-2 text-ink-300 dark:text-ink-700">·</span>
        Static and open
      </p>
    </div>
  </Container>
</section>
