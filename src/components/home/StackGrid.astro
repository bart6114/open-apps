---
import type { Stack } from "../../data/stacks";
import SectionHeader from "../layout/SectionHeader.astro";
import Container from "../layout/Container.astro";
import Icon from "../icons/Icon.astro";

interface Props {
  stacks: Stack[];
}

const { stacks } = Astro.props;

const statusLabel: Record<Stack["status"], string> = {
  live: "Live",
  expanding: "Expanding",
  planned: "Planned",
};

const statusBadge: Record<Stack["status"], string> = {
  live: "border-emerald-300/60 bg-emerald-50 text-emerald-700 dark:border-emerald-800/60 dark:bg-emerald-950/40 dark:text-emerald-300",
  expanding: "border-ink-200 bg-ink-50 text-ink-700 dark:border-ink-800 dark:bg-ink-900/60 dark:text-ink-300",
  planned: "border-ink-200 bg-white text-ink-500 dark:border-ink-800 dark:bg-ink-950 dark:text-ink-500",
};
---

<section
  id="stacks"
  class="section border-b border-ink-200 dark:border-ink-800"
>
  <Container>
    <SectionHeader
      eyebrow="Stacks"
      title="Browse by stack"
      description="Pick a stack to see real apps built with it."
    />

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        stacks.map((stack) => (
          <a
            href={`#stack-${stack.slug}`}
            class="card card-hover group flex h-full flex-col gap-3 p-5 no-underline"
          >
            {/* Large stack icon — the visual anchor of the card */}
            <div class="flex items-start justify-between gap-3">
              <div
                class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg border border-ink-200 bg-ink-50 p-2.5 dark:border-ink-800 dark:bg-ink-900/60"
                aria-hidden="true"
              >
                <Icon
                  name={stack.name}
                  category="stack"
                  size={36}
                  class="h-9 w-9"
                />
              </div>
              <span
                class={`badge shrink-0 ${statusBadge[stack.status]}`}
                aria-label={`Status: ${statusLabel[stack.status]}`}
              >
                {statusLabel[stack.status]}
              </span>
            </div>

            <h3 class="m-0 text-[1.0625rem] font-semibold tracking-tight text-ink-900 group-hover:underline dark:text-ink-100">
              {stack.name}
            </h3>

            <p class="m-0 text-2xs leading-relaxed text-ink-500 dark:text-ink-400">
              {stack.blurb}
            </p>

            {typeof stack.count === "number" && (
              <span class="mt-auto text-2xs font-mono text-ink-400 dark:text-ink-500">
                {stack.count} apps
              </span>
            )}
          </a>
        ))
      }
    </div>
  </Container>
</section>
