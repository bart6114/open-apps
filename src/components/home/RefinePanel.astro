---
import type { AppsFilters } from "../../lib/apps-search";

interface FacetOption {
  value: string;
  count: number;
}

interface Props {
  facets: {
    stacks: FacetOption[];
    platforms: FacetOption[];
    categories: FacetOption[];
    labels: FacetOption[];
    licenses: FacetOption[];
  };
  initial: AppsFilters;
  /** When true, the panel starts expanded. */
  defaultOpen?: boolean;
  class?: string;
}

const { facets, initial, defaultOpen = true, class: className = "" } = Astro.props;
const activeCount = (key: keyof AppsFilters) =>
  ((initial[key] as string[] | undefined) ?? []).length;

const totalActive =
  activeCount("stacks") +
  activeCount("platforms") +
  activeCount("categories") +
  activeCount("labels") +
  activeCount("licenses");

const hasActive = totalActive > 0;
const open = defaultOpen;

interface ChipGroup {
  label: string;
  /** State key in AppsFilters (plural, e.g. "stacks"). The URL key
   *  is mapped to/from this via searchParamsFromFilters / filtersFromSearchParams. */
  filterKey: "stacks" | "platforms" | "categories" | "labels" | "licenses";
  options: FacetOption[];
  initial: string[];
  /** Single-select: license is mutually exclusive. */
  single?: boolean;
}

const groups: ChipGroup[] = [
  { label: "Stack", filterKey: "stacks", options: facets.stacks, initial: initial.stacks ?? [] },
  { label: "Platform", filterKey: "platforms", options: facets.platforms, initial: initial.platforms ?? [] },
  { label: "Category", filterKey: "categories", options: facets.categories, initial: initial.categories ?? [] },
];
---

<section class={`${className}`} data-refine-panel={open ? "open" : "closed"}>
  <button
    type="button"
    id="refine-toggle"
    class="inline-flex items-center gap-1.5 rounded-md border border-ink-200 bg-white px-2.5 py-1 text-2xs font-medium text-ink-700 transition-colors hover:border-ink-300 hover:bg-ink-50 dark:border-ink-800 dark:bg-ink-950 dark:text-ink-300 dark:hover:border-ink-700 dark:hover:bg-ink-900/60"
    aria-expanded={open ? "true" : "false"}
    aria-controls="refine-content"
  >
    <svg
      viewBox="0 0 16 16"
      width="12"
      height="12"
      aria-hidden="true"
      fill="currentColor"
      class="transition-transform"
      id="refine-chevron"
      style={open ? "transform: rotate(90deg);" : ""}
    >
      <path d="M6.22 3.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L9.94 8 6.22 4.28a.75.75 0 0 1 0-1.06Z" />
    </svg>
    Refine results
    <span
      data-refine-count
      class={`ml-0.5 inline-flex h-4 min-w-4 items-center justify-center rounded-full bg-ink-900 px-1 text-[10px] font-semibold text-white dark:bg-ink-100 dark:text-ink-900 ${hasActive ? "" : "hidden"}`}
    >
      {totalActive}
    </span>
  </button>

  <div
    id="refine-content"
    class="mt-3 rounded-lg border border-ink-200 bg-white p-4 dark:border-ink-800 dark:bg-ink-950"
    hidden={!open}
  >
    <div class="flex flex-col gap-3.5">
      {groups.map((group) => {
        const initialSet = new Set(group.initial);
        return (
          <div class="flex flex-col gap-1.5 sm:flex-row sm:items-center sm:gap-3">
            <div class="w-20 shrink-0 text-2xs font-semibold uppercase tracking-wider text-ink-500 dark:text-ink-400">
              {group.label}
            </div>
            <div class="flex flex-1 flex-wrap gap-1" data-chip-row={group.filterKey}>
              {group.options.length === 0 && (
                <span class="text-2xs text-ink-400 dark:text-ink-500">—</span>
              )}
              {group.options.map((opt) => {
                const isActive = initialSet.has(opt.value);
                return (
                  <button
                    type="button"
                    class="chip-btn inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-2xs font-medium transition-colors border-ink-200 bg-white text-ink-700 hover:border-ink-300 hover:bg-ink-50 dark:border-ink-800 dark:bg-ink-950 dark:text-ink-300 dark:hover:border-ink-700 dark:hover:bg-ink-900/60 aria-pressed:border-ink-900 aria-pressed:bg-ink-900 aria-pressed:text-white dark:aria-pressed:border-ink-100 dark:aria-pressed:bg-ink-100 dark:aria-pressed:text-ink-900"
                    data-filter-chip
                    data-filter-key={group.filterKey}
                    data-filter-value={opt.value}
                    data-filter-single={group.single ? "true" : undefined}
                    aria-pressed={isActive ? "true" : "false"}
                  >
                    <span>{opt.value}</span>
                    <span
                      class={`text-[10px] tabular-nums ${
                        isActive
                          ? "text-white/70 dark:text-ink-900/60"
                          : "text-ink-400 dark:text-ink-500"
                      }`}
                    >{opt.count}</span>
                  </button>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  // Toggle the refine panel
  const toggle = document.getElementById("refine-toggle");
  const content = document.getElementById("refine-content");
  const chevron = document.getElementById("refine-chevron");
  const section = toggle?.closest("[data-refine-panel]");
  if (toggle && content && chevron && section) {
    toggle.addEventListener("click", () => {
      const isOpen = section.getAttribute("data-refine-panel") === "open";
      const next = isOpen ? "closed" : "open";
      section.setAttribute("data-refine-panel", next);
      toggle.setAttribute("aria-expanded", isOpen ? "false" : "true");
      content.hidden = isOpen;
      chevron.style.transform = isOpen ? "" : "rotate(90deg)";
    });
  }

  // Chip clicks are handled by the same listener in src/pages/apps/index.astro
  // which delegates clicks on [data-filter-key]. No separate handler needed.
</script>
