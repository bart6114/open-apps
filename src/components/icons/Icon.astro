interface Props {
  name: string;
  size?: number;
  class?: string;
  title?: string;
}

const { name, size = 14, class: className = "", title } = Astro.props;

// Normalize the name to a lookup key. Case-insensitive, spaces → dash.
const key = name.toLowerCase().trim().replace(/\s+/g, "-");
const def = ICONS[key];

// If we don't know the icon, fall back to a small filled dot so the
// chip still has visual weight. Better than a missing-glyph blank.
const fallback = `<circle cx="12" cy="12" r="4" fill="currentColor"/>`;
const body = def?.body ?? fallback;
const stroke = def?.outline
  ? `fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"`
  : `fill="currentColor"`;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden={title ? undefined : "true"}
  role={title ? "img" : undefined}
  class={className}
  set:html={`${title ? `<title>${title}</title>` : ""}<g ${stroke}>${body}</g>`}
/>
