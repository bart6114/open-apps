---
// Single icon registry. Renders a monochrome SVG by name, using
// `currentColor` so chips inherit the chip's text color.
//
// Add new icons by extending the ICONS map below. Keep paths square
// (24x24 viewBox) and stroke/fill rules consistent so they line up
// next to each other in a chip row.

interface IconDef {
  /** body — a single SVG path or compound <path> markup. Should sit on
   *  a 24x24 viewBox. Use stroke="currentColor" / fill="currentColor" so
   *  the icon inherits the chip text color. */
  body: string;
  /** true = stroked / outline icon; false = filled / solid icon. */
  outline: boolean;
}

