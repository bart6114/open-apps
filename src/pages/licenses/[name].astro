---
import BaseLayout from "@grove-dev/astro/layouts/BaseLayout.astro";
import { itemLabelPlural, getTaxonomyPageModel } from "@grove-dev/astro/server";
import siteConfig from "@grove/generated/site-config.json";
import TaxonomyList from "../../components/TaxonomyList.astro";

export function getStaticPaths() {
  const licenses = siteConfig.taxonomy?.licenses ?? [];
  return licenses.map(({ id, name }) => ({
    params: { name: id },
    props: { displayName: name },
  }));
}

const { displayName } = Astro.props;
const name = Astro.params.name;
const items = itemLabelPlural();
const model = getTaxonomyPageModel("licenses", name, displayName, siteConfig);
const { records, seo } = model;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  image={seo.image}
  imageAlt={seo.imageAlt}
  jsonLd={seo.jsonLd}
  site={siteConfig}
>
  <TaxonomyList
    eyebrow={model.eyebrow}
    displayName={displayName}
    lede={`Browse open-source ${items} in this directory licensed under ${displayName}.`}
    records={records}
  />
</BaseLayout>
