---
import BaseLayout from "@grove-dev/astro/layouts/BaseLayout.astro";
import Container from "@grove-dev/astro/layouts/Container.astro";
import { getPageContentHtml } from "@grove-dev/astro/server";
import siteConfig from "@grove/generated/site-config.json";

const title = `About — ${siteConfig.name}`;
const description =
  "Why Open Apps curates real open-source application codebases and how the directory is maintained.";
const githubUrl = siteConfig.repoUrl;
const pageContentHtml = getPageContentHtml("about");
---

<BaseLayout title={title} description={description} site={siteConfig}>
  <Container size="narrow">
    <article class="py-12 sm:py-16">
      <nav class="text-2xs text-ink-500 dark:text-ink-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-ink-900 dark:hover:text-ink-100">Home</a>
        <span class="mx-1.5 text-ink-300 dark:text-ink-700">/</span>
        <span class="text-ink-700 dark:text-ink-300">About</span>
      </nav>

      <header class="mt-5">
        <span class="text-2xs font-medium uppercase tracking-wider text-ink-500 dark:text-ink-400">
          About
        </span>
        <h1 class="m-0 mt-1 text-[1.75rem] font-semibold leading-[1.1] tracking-[-0.02em] text-ink-900 sm:text-[2.25rem] dark:text-ink-100">
          A directory of real open-source apps.
        </h1>
        <p class="m-0 mt-4 max-w-[62ch] text-[1rem] leading-relaxed text-ink-700 sm:text-[1.0625rem] dark:text-ink-200">
          Open Apps helps developers find applications they can run, compare,
          study, and contribute to — with more context than a repository name
          and star count.
        </p>
      </header>

      {pageContentHtml && (
        <section class="grove-prose mt-8" set:html={pageContentHtml} />
      )}

      <section class="mt-8 flex flex-wrap items-center gap-3">
        <a href="/apps" class="inline-flex h-8 items-center justify-center rounded-[var(--radius)] bg-primary px-3 text-sm font-medium text-primary-foreground no-underline transition-colors hover:bg-primary/90">
          Browse the directory
        </a>
        {githubUrl && (
          <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="inline-flex h-8 items-center justify-center rounded-[var(--radius)] border border-border bg-secondary px-3 text-sm font-medium text-foreground no-underline transition-colors hover:bg-accent">
            View on GitHub
          </a>
        )}
        <a href="/submit" class="inline-flex h-8 items-center justify-center rounded-[var(--radius)] px-3 text-sm font-medium text-foreground no-underline transition-colors hover:bg-accent">
          Submit an app →
        </a>
      </section>
    </article>
  </Container>
</BaseLayout>
