---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/home/Hero.astro";
import AppSection from "../components/home/AppSection.astro";
import StackGrid from "../components/home/StackGrid.astro";
import CategoryGrid from "../components/home/CategoryGrid.astro";
import ContributorsGrid from "../components/home/ContributorsGrid.astro";
import OriginalCollection from "../components/home/OriginalCollection.astro";
import MinimalAbout from "../components/home/MinimalAbout.astro";

import { newApps, hotApps, matureApps } from "../data/apps";
import { stacks } from "../data/stacks";
import { categories } from "../data/categories";
import { contributors } from "../data/contributors";
import { stats } from "../data/stats";

const newList = newApps().slice(0, 6);
const hotList = hotApps().slice(0, 6);
const matureList = matureApps().slice(0, 6);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="A static, community-curated directory of real open-source application codebases. Starting with mobile."
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%2318181b'/%3E%3C/svg%3E"
    />
    <title>Open Source Apps — Discover real open-source apps</title>
    {/* Theme bootstrap. Runs before paint to avoid a flash of the
        wrong theme. Listens for `theme:set` events from the
        ThemeToggle component. */}
    <script is:inline>
      (function () {
        var STORAGE_KEY = "open-apps-theme";
        function getMode() {
          var stored = localStorage.getItem(STORAGE_KEY);
          if (stored === "light" || stored === "dark" || stored === "system") return stored;
          return "system";
        }
        function apply(mode) {
          var resolved =
            mode === "system"
              ? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
              : mode;
          var root = document.documentElement;
          if (resolved === "dark") root.classList.add("dark");
          else root.classList.remove("dark");
          root.dataset.theme = mode;
          root.dataset.resolvedTheme = resolved;
        }
        apply(getMode());
        // React to toggle button clicks
        window.addEventListener("theme:set", function (e) { apply(e.detail); });
        // React to OS-level changes when in "system" mode
        var mq = window.matchMedia("(prefers-color-scheme: dark)");
        mq.addEventListener("change", function () {
          if (getMode() === "system") apply("system");
        });
      })();
    </script>
  </head>
  <body class="min-h-screen bg-white text-ink-900 dark:bg-ink-950 dark:text-ink-100">
    <Header />

    <main>
      <Hero />

      <AppSection
        id="new"
        title="New open-source apps"
        description="Recently added projects from the community."
        apps={newList}
      />

      <AppSection
        id="hot"
        title="Hot open-source apps"
        description="Projects gaining attention, stars, or recent activity."
        apps={hotList}
      />

      <AppSection
        id="mature"
        title="Mature open-source apps"
        description="Established projects with strong history, clear codebases, or real-world usage."
        apps={matureList}
      />

      <StackGrid stacks={stacks} />

      <CategoryGrid categories={categories} />

      <ContributorsGrid contributors={contributors} />

      <OriginalCollection stats={stats} />

      <MinimalAbout />
    </main>

    <Footer />
  </body>
</html>
