---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import WhyThisExists from "../components/home/WhyThisExists.astro";
import AppSection from "../components/home/AppSection.astro";
import StackGrid from "../components/home/StackGrid.astro";
import CategoryGrid from "../components/home/CategoryGrid.astro";
import ContributorsGrid from "../components/home/ContributorsGrid.astro";
import OriginalCollection from "../components/home/OriginalCollection.astro";

import { newApps, hotApps, matureApps } from "../data/apps";
import { stacks } from "../data/stacks";
import { categories } from "../data/categories";
import { contributors } from "../data/contributors";
import { stats } from "../data/stats";

const hotList = hotApps().slice(0, 6);
const newList = newApps().slice(0, 6);
const matureList = matureApps().slice(0, 6);

const title = "Open Source Apps — A directory of real open-source applications";
const description =
  "A searchable directory of real open-source applications — organized by stack, category, platform, license, activity, and maturity.";
---

<BaseLayout title={title} description={description}>
      <Hero />

      <WhyThisExists />

      <AppSection
        id="hot"
        title="Trending now"
        description="Projects gaining stars, activity, or attention recently."
        apps={hotList}
        viewAllHref="/apps?label=hot"
        viewAllLabel="View all trending"
      />

      <AppSection
        id="new"
        title="Recently added"
        description="Apps added to the directory in the last few weeks."
        apps={newList}
        viewAllHref="/apps?label=new"
        viewAllLabel="View all recently added"
      />

      <AppSection
        id="mature"
        title="Established apps"
        description="Long-running apps with strong history, active maintainers, and real-world usage."
        apps={matureList}
        viewAllHref="/apps?label=mature"
        viewAllLabel="View all established"
      />

      <StackGrid stacks={stacks} />

      <CategoryGrid categories={categories} />

      <ContributorsGrid contributors={contributors} />

      <OriginalCollection stats={stats} />
</BaseLayout>
