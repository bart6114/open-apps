---
/**
 * Home page — generic.
 *
 * Mirrors the openapps structure: Hero → WhyThisExists → three
 * lens sections (hot / new / mature) → StackGrid → CategoryGrid →
 * ContributorsGrid → OriginalCollection.
 *
 * All data derives from `data/generated/records.{index,full}.json`
 * and `data/generated/site-config.json`. Nothing here is hardcoded
 * to a specific blueprint — section copy uses singular/plural
 * labels from `itemLabel()`/`itemLabelPlural()`.
 */
import BaseLayout from "@grove-dev/astro/layouts/BaseLayout.astro";
import Hero from "@grove-dev/astro/components/Hero.astro";
import WhyThisExists from "@grove-dev/astro/components/WhyThisExists.astro";
import RecordSection from "@grove-dev/astro/components/RecordSection.astro";
import StackGrid from "@grove-dev/astro/components/StackGrid.astro";
import CategoryGrid from "@grove-dev/astro/components/CategoryGrid.astro";
import ContributorsGrid from "@grove-dev/astro/components/ContributorsGrid.astro";
import OriginalCollection from "@grove-dev/astro/components/OriginalCollection.astro";
import FinalCta from "@grove-dev/astro/components/FinalCta.astro";
import CollectionTeaser from "@grove-dev/astro/components/CollectionTeaser.astro";

import {
  getHomePageModel,
  getCollectionTeaserModel,
  recordsToCollectionEntries,
  loadCollections,
} from "@grove-dev/astro/server";
import records from "@grove/generated/records.json";
import siteConfig from "@grove/generated/site-config.json";

const home = getHomePageModel(siteConfig);
const { slug, itemSingular, itemPlural } = home;

// ── Lens sectioning (Hot / New / Mature) ────────────────────────
// The audit called out the homepage as too long with three near-
// identical 6-card sections. Drop Established from the home page
// (the curated 'Top Open Source Flutter Apps' / 'Top Open Source
// iOS Apps' collections cover that lens with auditable
// criteria). Keep Trending + Recently added and trim each to 3.
const hotList = home.hot.slice(0, 3);
const newList = home.recentlyAdded.slice(0, 3);

const { stacks, categories } = home;

const { contributors, stats, title, description } = home;

// ── Featured collections teaser ─────────────────────────────────
const allCollections = await loadCollections(process.cwd());
const teaserEntries = recordsToCollectionEntries(
  (records as { records: unknown[] }).records as never,
  siteConfig,
);
const collectionTeaser = getCollectionTeaserModel(allCollections, teaserEntries, 3);
---

<BaseLayout title={title} description={description} site={siteConfig}>
  <Hero
    name={`Find ${itemPlural} you can actually\u00a0`}
    tagline="run, study, and contribute to."
    description={description}
    eyebrow={`A directory of real curated ${itemPlural}`}
    eyebrowBadge="Beta"
    stats={{
      totalApps: stats.apps,
      totalCategories: stats.categories,
      totalStacks: stats.stacks,
      totalOwners: stats.owners,
      totalStars: stats.stars,
      originalRepo: stats.originalRepo,
    }}
    itemsLabel={itemPlural}
    itemLabel={itemSingular}
    searchHref={`/${slug}`}
    searchPlaceholder={`Search ${itemPlural}, stacks, or categories...`}
    quickFilters={[
      { label: `Trending ${itemPlural}`, href: `/${slug}?label=hot` },
      { label: "Recently added", href: `/${slug}?sort=recently-added` },
      { label: "Established", href: `/${slug}?label=mature` },
    ]}
    ctas={[
      { label: `Browse ${itemPlural}`, href: `/${slug}`, variant: "primary" },
      { label: `Submit ${itemSingular}`, href: "/submit", variant: "outline" },
    ]}
  />

  <WhyThisExists />

  <RecordSection
    id="hot"
    title="Trending now"
    description={`${itemPlural.charAt(0).toUpperCase() + itemPlural.slice(1)} gaining stars, activity, or attention recently.`}
    eyebrow="Hot"
    items={hotList}
    hrefFor={(r) => `/${slug}/${r.slug}`}
    viewAllHref={`/${slug}?label=hot`}
    viewAllLabel={`View all trending ${itemPlural}`}
  />

  <RecordSection
    id="new"
    title="Recently added"
    description={`${itemPlural.charAt(0).toUpperCase() + itemPlural.slice(1)} added to the directory in the last few weeks.`}
    eyebrow="New"
    items={newList}
    hrefFor={(r) => `/${slug}/${r.slug}`}
    viewAllHref={`/${slug}?sort=recently-added`}
    viewAllLabel={`View all recently added`}
  />

  <StackGrid stacks={stacks} pathPrefix={`/${slug}`} itemLabelPlural={itemPlural} />
  <CollectionTeaser model={collectionTeaser} />
  <CategoryGrid categories={categories} pathPrefix={`/${slug}`} itemLabelPlural={itemPlural} />

  <section class="grove-card mt-12 rounded-[var(--radius-lg)] border border-ink-200 bg-background p-5 dark:border-ink-800">
    <h2 class="grove-card-title m-0 mb-1 text-2xs font-semibold uppercase tracking-wider text-ink-500 dark:text-ink-400">
      Community
    </h2>
    <p class="m-0 text-sm leading-relaxed text-ink-700 dark:text-ink-200">
      <a href="/contributors" class="text-inherit no-underline hover:underline">
        {contributors.length} human contributors
      </a>
      {" "}have curated or reviewed entries on this directory.{" "}
      <a href="/contributors" class="text-inherit no-underline hover:underline">See everyone →</a>
    </p>
  </section>

  {siteConfig.stats?.originalRepo && (
    <OriginalCollection
      repoUrl={siteConfig.stats.originalRepo}
      stats={{
        stars: siteConfig.stats.originalStars,
        forks: siteConfig.stats.originalForks,
        contributors: siteConfig.stats.originalContributors,
      }}
    />
  )}

  <FinalCta
    itemLabel={itemSingular}
    itemsLabel={itemPlural}
    browseHref={`/${slug}`}
  />
</BaseLayout>
