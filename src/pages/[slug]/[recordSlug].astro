---
/**
 *  Detail page — one record at a time.
 *
 *  Thin composable page built on top of the canary
 *  `@grove-dev/astro` components. The canary version of this page
 *  (in apps/example) is 60 lines and renders:
 *
 *    1. RecordHeader            — avatar, pills, h1, owner/repo, CTAs
 *    2. EditorialSummary        — Best for / Caveats grid
 *    3. TableOfContents         — from `extractToc(record.content)`
 *    4. MarkdownBody            — `getContentHtml(recordSlug)`
 *    5. RecordSidebar           — Activity / Freshness / Ecosystem /
 *                                  Source cards (sticky on lg+)
 *
 *  Generic across the 3 record kinds (project / resource / entity).
 *  The URL is dynamic on `[slug]` (the blueprint route, e.g.
 *  `apps`/`resources`/`entities`) and `[recordSlug]` (the record
 *  slug); a single page file serves every blueprint and every record.
 *
 *  This replaces the previous 527-line hand-rolled version, which
 *  duplicated the sidebar / header / TOC / markdown rendering that
 *  the canary components now own. Adopting the canary surface keeps
 *  the consumer in sync with the framework's design choices (WCAG,
 *  Shiki themes, dark-mode treatment, activity badges, etc.).
 */
import siteConfig from "@grove/generated/site-config.json";
import {
  getRecordDetailModel,
  recordDetailPaths,
} from "@grove-dev/astro/server";
import BaseLayout from "@grove-dev/astro/layouts/BaseLayout.astro";
import RecordHeader from "@grove-dev/astro/components/RecordHeader.astro";
import EditorialSummary from "@grove-dev/astro/components/EditorialSummary.astro";
import TableOfContents from "@grove-dev/astro/components/TableOfContents.astro";
import MarkdownBody from "@grove-dev/astro/components/MarkdownBody.astro";
import RecordSidebar from "@grove-dev/astro/components/RecordSidebar.astro";

export function getStaticPaths() {
  return recordDetailPaths(siteConfig);
}

const dirSlug = siteConfig.blueprintConfig?.routeSlug ?? "apps";
const detail = getRecordDetailModel(
  Astro.params.recordSlug ?? "",
  siteConfig,
  Astro.params.slug ?? dirSlug,
);
if (!detail) return Astro.redirect(`/${dirSlug}`);
const { record, name, title, description, itemSingular, jsonLd } = detail;
---

<BaseLayout
  title={title}
  description={description}
  site={siteConfig}
  type="article"
  jsonLd={jsonLd}
  submitHref="/submit"
  submitLabel={`Submit ${itemSingular}`}
>
  <article class="py-10 sm:py-14">
    <div class="mx-auto w-full max-w-[1240px] px-5 sm:px-7">
      <nav class="mb-6 text-2xs text-ink-500 dark:text-ink-400" aria-label="Breadcrumb">
        <a href={`/${dirSlug}`} class="hover:text-ink-900 dark:hover:text-ink-100 capitalize">
          {dirSlug}
        </a>
        <span class="mx-1.5 text-ink-300 dark:text-ink-700">/</span>
        <span class="text-ink-700 dark:text-ink-300">{name}</span>
      </nav>

      <RecordHeader detail={detail} />

      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-12 xl:grid-cols-[minmax(0,1fr)_340px]">
        <div class="min-w-0">
          <EditorialSummary bestFor={detail.bestFor} caveats={detail.caveats} />
          <TableOfContents items={detail.toc} />
          <MarkdownBody
            recordSlug={record.slug}
            fallback={record.content ? undefined : "This record doesn't have notes yet."}
          />
        </div>
        <RecordSidebar detail={detail} />
      </div>
    </div>
  </article>
</BaseLayout>
