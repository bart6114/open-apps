---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import Container from "../../components/layout/Container.astro";
import SmartLensTabs from "../../components/home/SmartLensTabs.astro";
import RefinePanel from "../../components/home/RefinePanel.astro";
import AppsIndexRow from "../../components/home/AppsIndexRow.astro";
import AppsPagination from "../../components/home/AppsPagination.astro";
import ExploreByCategory from "../../components/home/ExploreByCategory.astro";
import ExploreByStack from "../../components/home/ExploreByStack.astro";

import { apps } from "../../data/apps";
import {
  buildFacets,
  filtersFromSearchParams,
  searchParamsFromFilters,
  filterApps,
  activeFilterChips,
  applySort,
  paginate,
  totalPages,
  PAGE_SIZE,
  effectiveSort,
  effectivePage,
  SORT_OPTIONS,
  type AppsFilters,
} from "../../lib/apps-search";
import { lensFromSearchParams } from "../../lib/lenses";
import { labelDisplay, lensDisplay, sortDisplay, statusDisplay } from "../../lib/display";
import { categories } from "../../data/categories";
import { stacks } from "../../data/stacks";
import { stats } from "../../data/stats";

// Parse URL → filters, then derive the effective (post-default) values.
const initialFilters = filtersFromSearchParams(Astro.url.searchParams);
const initialLens = lensFromSearchParams(Astro.url.searchParams);
const facets = buildFacets(apps);
const sort = effectiveSort(initialFilters);
const page = effectivePage(initialFilters);
const initialChips = activeFilterChips(initialFilters);

// Apply filter → sort → paginate server-side. URL is the source of
// truth; this page is fully SSR. No client-side render loop.
const filtered = filterApps(apps, initialFilters);
const sorted = applySort(filtered, sort);
const totalFiltered = sorted.length;
const totalFilteredPages = totalPages(totalFiltered);
const safePage = Math.min(page, totalFilteredPages);
const pageApps = paginate(sorted, safePage);
const initialChipsTotal = initialChips.length;

const githubUrl = stats.originalRepo;

// Build a "next page" / "prev page" href that preserves every other
// filter param. Reused by the pagination component.
function hrefForPage(target: number): string {
  const next: AppsFilters = { ...initialFilters, page: target };
  const sp = searchParamsFromFilters(next);
  const qs = sp.toString();
  return qs ? `/apps?${qs}` : "/apps";
}

function hrefForClearAll(): string {
  return "/apps";
}

// Map a chip's filter key + value to a URL that drops just that value
// and resets to page 1. Used for the "×" button on each active chip.
const KEY_TO_URL: Record<string, string> = {
  q: "q",
  stacks: "stack",
  platforms: "platform",
  categories: "category",
  labels: "label",
  licenses: "license",
  lens: "lens",
};
function hrefForRemove(chip: { key: keyof typeof initialFilters | string; value: string }): string {
  const sp = new URLSearchParams(Astro.url.searchParams);
  sp.delete("page");
  const key = chip.key as string;
  if (key === "statuses") {
    // Status is stored as a single comma-joined param. Drop only the
    // matching value so other statuses stay selected.
    const current = (sp.get("status") ?? "").split(",").filter(Boolean);
    const next = current.filter((v) => v !== chip.value);
    sp.delete("status");
    if (next.length) sp.set("status", next.join(","));
  } else if (key === "q") {
    sp.delete("q");
  } else {
    const urlKey = KEY_TO_URL[key];
    if (urlKey) {
      const all = sp.getAll(urlKey).filter((v) => v !== chip.value);
      sp.delete(urlKey);
      for (const v of all) sp.append(urlKey, v);
    } else {
      sp.delete(key);
    }
  }
  const qs = sp.toString();
  return qs ? `/apps?${qs}` : "/apps";
}

// Human-readable summary line under the search.
const sortLabel = sortDisplay(sort);
const filterSummary: string[] = [];
if (initialFilters.q) filterSummary.push(`matching “${initialFilters.q}”`);
if (initialFilters.stacks?.length)
  filterSummary.push(`stack: ${initialFilters.stacks.join(", ")}`);
if (initialFilters.platforms?.length)
  filterSummary.push(`platform: ${initialFilters.platforms.join(", ")}`);
if (initialFilters.categories?.length)
  filterSummary.push(`category: ${initialFilters.categories.join(", ")}`);
if (initialFilters.licenses?.length)
  filterSummary.push(`license: ${initialFilters.licenses.join(", ")}`);
if (initialFilters.labels?.length)
  filterSummary.push(`label: ${initialFilters.labels.map((l) => labelDisplay(l) ?? l).join(", ")}`);
if (initialLens) filterSummary.push(`lens: ${lensDisplay(initialLens)}`);
if (initialFilters.statuses?.length) {
  const joined = initialFilters.statuses.join(",");
  if (joined === "stale,quiet") {
    filterSummary.push(`status: ${statusDisplay("needs-maintainer")}`);
  } else {
    filterSummary.push(`status: ${initialFilters.statuses.map((s) => statusDisplay(s)).join(", ")}`);
  }
}
const hasAnyFilter =
  Boolean(initialFilters.q) ||
  (initialFilters.stacks?.length ?? 0) > 0 ||
  (initialFilters.platforms?.length ?? 0) > 0 ||
  (initialFilters.categories?.length ?? 0) > 0 ||
  (initialFilters.labels?.length ?? 0) > 0 ||
  (initialFilters.licenses?.length ?? 0) > 0 ||
  (initialFilters.statuses?.length ?? 0) > 0 ||
  Boolean(initialLens);

const title = "Browse open-source apps — Open Source Apps";
const description =
  "Search and filter real open-source applications by platform, stack, category, license, and activity.";
---

<BaseLayout title={title} description={description}>
      <Container>
        <header class="py-8 sm:py-10">
          <span
            class="text-2xs font-medium uppercase tracking-wider text-ink-500 dark:text-ink-400"
            >Apps</span
          >
          <h1
            class="mt-1 m-0 text-[1.75rem] sm:text-[2rem] font-semibold tracking-[-0.02em] leading-[1.1] text-ink-900 dark:text-ink-100"
          >
            Browse open-source apps
          </h1>
          <p
            class="mt-2 m-0 max-w-[64ch] text-[0.9375rem] leading-relaxed text-ink-500 dark:text-ink-400"
          >
            Search and filter real open-source applications by platform,
            stack, category, license, and activity. Every entry is a real
            codebase with hand-curated context.
          </p>
        </header>
      </Container>

      {/* ── Filter area ─────────────────────────────────────────────
            One cohesive section. Lenses (curated views) sit on top,
            field filters below them, search + sort on the third row.
            A single bottom border separates it from the result list.
            No internal dividers — the visual distinction between
            "tabs" (lenses) and "dropdowns" (filters) does the work. */}
      <section class="border-b border-ink-200 bg-white dark:border-ink-800 dark:bg-ink-950">
        <Container>
          <div class="py-5">
            {/* Search + sort row */}
            <form
              id="search-form"
              class="flex flex-col gap-2 sm:flex-row sm:items-stretch"
              role="search"
            >
              <label class="relative flex-1">
                <span class="sr-only">Search apps by name, description, owner, category</span>
                <svg
                  viewBox="0 0 16 16"
                  width="16"
                  height="16"
                  aria-hidden="true"
                  class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-400"
                  fill="currentColor"
                >
                  <path d="M10.68 11.74a6 6 0 0 1-7.922-8.982 6 6 0 0 1 8.982 7.922l3.04 3.04a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215ZM11.5 7a4.499 4.499 0 1 0-8.997 0A4.499 4.499 0 0 0 11.5 7Z" />
                </svg>
                <input
                  id="search-input"
                  type="search"
                  name="q"
                  value={initialFilters.q ?? ""}
                  placeholder="Search apps, stacks, categories, platforms, licenses..."
                  autocomplete="off"
                  class="h-9 w-full rounded-md border border-ink-200 bg-white py-2 pl-9 pr-3 text-[0.875rem] text-ink-900 placeholder:text-ink-400 focus:border-ink-900 focus:outline-none focus:ring-2 focus:ring-ink-900/10 dark:border-ink-800 dark:bg-ink-950 dark:text-ink-100 dark:placeholder:text-ink-500 dark:focus:border-ink-100 dark:focus:ring-ink-100/15"
                />
              </label>

              <label class="relative">
                <span class="sr-only">Sort apps</span>
                <select
                  id="sort-select"
                  class="h-9 cursor-pointer appearance-none rounded-md border border-ink-200 bg-white py-1.5 pl-3 pr-8 text-[0.8125rem] font-medium text-ink-700 transition-colors hover:border-ink-300 focus:border-ink-900 focus:outline-none focus:ring-2 focus:ring-ink-900/10 dark:border-ink-800 dark:bg-ink-950 dark:text-ink-300 dark:hover:border-ink-700 dark:focus:border-ink-100 dark:focus:ring-ink-100/15"
                >
                  {SORT_OPTIONS.map((o) => (
                    <option value={o.value} selected={o.value === sort}>{o.label}</option>
                  ))}
                </select>
                <svg
                  viewBox="0 0 16 16"
                  width="11"
                  height="11"
                  aria-hidden="true"
                  class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-ink-400"
                  fill="currentColor"
                >
                  <path d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z"/>
                </svg>
              </label>
            </form>

            {/* Lenses row — single-select curated views */}
            <div class="mt-3">
              <SmartLensTabs currentParams={Astro.url.searchParams} />
            </div>

            {/* Filters row — multi-value field filters */}
            <div class="mt-2.5">
              <RefinePanel facets={facets} initial={initialFilters} />
            </div>
          </div>
        </Container>
      </section>

      {/* ── Results ───────────────────────────────────────────────── */}
      <section>
        <Container>
          <div class="py-6 sm:py-8">
            {/* Summary + active chips. Always rendered (not sticky) so
                the user can see what filters are active and remove
                them with one click without scrolling back up. */}
            <div
              id="result-summary"
              class="flex flex-col gap-2.5 text-2xs sm:flex-row sm:items-center sm:justify-between"
            >
              <p class="m-0 text-ink-500 dark:text-ink-400">
                <span
                  id="apps-results-count"
                  class="font-mono text-ink-900 dark:text-ink-100"
                  data-total={totalFiltered}
                  data-page-count={pageApps.length}
                  data-page-size={PAGE_SIZE}
                  data-page={safePage}
                  data-pages={totalFilteredPages}
                >
                  {totalFiltered} {totalFiltered === 1 ? "app" : "apps"}
                </span>
                <span class="text-ink-400 dark:text-ink-500">
                  {" · "}sorted by {sortLabel}
                </span>
                {totalFilteredPages > 1 && (
                  <span class="text-ink-400 dark:text-ink-500">
                    {" · "}page {safePage} of {totalFilteredPages}
                  </span>
                )}
              </p>

              {initialChipsTotal > 0 ? (
                <div
                  id="apps-active-chips"
                  class="flex flex-wrap items-center gap-1.5"
                  aria-label="Active filters"
                >
                  {initialChips.map((chip) => (
                    <a
                      href={hrefForRemove(chip)}
                      class="apps-active-chip group inline-flex items-center gap-1 rounded-md border border-ink-200 bg-white px-1.5 py-0.5 text-2xs font-medium text-ink-700 transition-colors hover:border-ink-300 hover:bg-ink-50 dark:border-ink-800 dark:bg-ink-950 dark:text-ink-300 dark:hover:border-ink-700 dark:hover:bg-ink-900/60"
                      aria-label={`Remove filter ${chip.label}`}
                    >
                      <span>{chip.label}</span>
                      <span aria-hidden="true" class="text-ink-400 group-hover:text-ink-700 dark:text-ink-500 dark:group-hover:text-ink-200">×</span>
                    </a>
                  ))}
                  <a
                    id="apps-clear-all"
                    href={hrefForClearAll()}
                    class="text-2xs text-ink-500 hover:text-ink-900 dark:text-ink-400 dark:hover:text-ink-100"
                  >
                    Clear all
                  </a>
                </div>
              ) : filterSummary.length > 0 ? (
                <span id="apps-filters-summary" class="text-ink-400 dark:text-ink-500">
                  filtered by {filterSummary.join(" · ")}
                </span>
              ) : null}
            </div>

            <div class="mt-5">
              {pageApps.length === 0 ? (
                <div
                  id="empty-state"
                  class="flex flex-col items-center gap-3 py-16 text-center"
                >
                  <p class="m-0 text-[0.9375rem] font-medium text-ink-700 dark:text-ink-200">
                    No apps found for these filters.
                  </p>
                  <p class="m-0 max-w-[44ch] text-2xs text-ink-500 dark:text-ink-400">
                    Try removing a filter, clearing the search, or picking a
                    different lens.
                  </p>
                  <div class="mt-3 flex flex-wrap items-center justify-center gap-2">
                    {hasAnyFilter && (
                      <a href="/apps" class="btn-outline">Clear filters</a>
                    )}
                    <a href="/apps" class="btn-ghost">Browse all apps</a>
                    <a href="/submit" class="btn-ghost">Submit an app</a>
                  </div>
                </div>
              ) : (
                <div
                  id="apps-results-list"
                  class="flex flex-col gap-3"
                >
                  {pageApps.map((app) => <AppsIndexRow app={app} />)}
                </div>
              )}
            </div>

            <div class="mt-6">
              <AppsPagination
                current={safePage}
                total={totalFilteredPages}
                hrefFor={hrefForPage}
              />
            </div>
          </div>
        </Container>
      </section>

      {/* ── Explore: navigation (not filters) ── */}
      <ExploreByCategory categories={categories} />
      <ExploreByStack stacks={stacks} />

      {/* ── Submit CTA ── */}
      <section class="border-t border-ink-200 dark:border-ink-800">
        <Container>
          <div class="flex flex-col items-center gap-3 py-12 text-center">
            <h2
              class="m-0 text-[1.25rem] font-semibold tracking-tight text-ink-900 dark:text-ink-100"
            >
              Know a real open-source app that belongs here?
            </h2>
            <p
              class="m-0 max-w-[48ch] text-[0.875rem] text-ink-500 dark:text-ink-400"
            >
              Open a pull request with a YAML file. We review every
              submission against the bar — no marketing, no tutorials.
            </p>
            <a
              href={`${githubUrl}/blob/main/CONTRIBUTING.md`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
              >Submit via GitHub</a
            >
          </div>
        </Container>
      </section>
    {/* Initial state for the search form is server-rendered; this script
        only handles debounced search updates + chip removal so the URL
        stays canonical and SSR matches client expectations. */}
    <script>
      import {
        filtersFromSearchParams,
        searchParamsFromFilters,
        type AppsFilters,
      } from "../../lib/apps-search";

      function readFilters(): AppsFilters {
        return filtersFromSearchParams(new URLSearchParams(location.search));
      }
      function writeFilters(f: AppsFilters) {
        const sp = searchParamsFromFilters(f);
        const qs = sp.toString();
        location.assign(qs ? `?${qs}` : location.pathname);
      }

      // Sort dropdown: navigate (server re-renders the sorted list).
      const sortSelect = document.getElementById("sort-select") as HTMLSelectElement | null;
      sortSelect?.addEventListener("change", () => {
        const f = readFilters();
        f.sort = (sortSelect.value as AppsFilters["sort"]) || undefined;
        f.page = 1;
        writeFilters(f);
      });

      // Search: debounced, then navigate. Server renders the filtered
      // list and updates chips/summary in one pass.
      const searchInput = document.getElementById("search-input") as HTMLInputElement | null;
      if (searchInput) {
        let timer: number | undefined;
        const submit = () => {
          const f = readFilters();
          f.q = searchInput.value.trim() || undefined;
          f.page = 1;
          writeFilters(f);
        };
        searchInput.addEventListener("input", () => {
          if (timer) window.clearTimeout(timer);
          timer = window.setTimeout(submit, 250);
        });
        document.getElementById("search-form")?.addEventListener("submit", (e) => {
          e.preventDefault();
          if (timer) window.clearTimeout(timer);
          submit();
        });
      }
    </script>

    <style>
    </style>
</BaseLayout>
