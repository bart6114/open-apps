# Build-time generated data. The `apps*.json` files are re-derived
# from data/apps/*.yml on every build and every GitHub Actions
# refresh — never commit them. `repo-stats.json` is the exception:
# it comes from the GitHub API for the open-apps repo itself, not
# from app YAMLs, and is the source of truth for the hero/header
# star and fork counts, so it IS tracked.
data/generated/apps.json
data/generated/apps.full.json
data/generated/apps.index.json
data/generated/react-native-candidates.json

# llms-full.txt is regenerated by `prebuild` from apps.json on every
# build, so it doesn't need to live in git history.
public/llms-full.txt

# Claude Code local settings — per-developer, never shared.
.claude/

# IDE / editor cruft
.idea/
.vscode/
*.swp
*.swo

# OS / shell
Thumbs.db

# One-off dev artifacts and large binary assets not needed at runtime
/art/
/docs/  # reserved for future design docs; currently empty
*.log
